{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/temple-tracker run build && ls -la artifacts/temple-tracker/dist/ && ls -la && pwd",
  "outputDirectory": "public",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "runtime": "@vercel/node@3",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.ts" }
  ]
}
