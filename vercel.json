{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/temple-tracker run build",
  "outputDirectory": "artifacts/temple-tracker/dist/public",
  "installCommand": "pnpm install",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "runtime": "@vercel/node@3",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.ts" }
  ]
}
